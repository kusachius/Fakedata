<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ReleaseVersion>1.10</ReleaseVersion>
    <PackageId>Kusachius.Fakedata</PackageId>
    <PackageVersion>$(ReleaseVersion).0</PackageVersion>
    <Authors>Aldis Arust</Authors>
    <Description>Random Lithuanian person, company, and address data for tests and development.</Description>
    <PackageTags>Lithuanian;fake data;test data;faker</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/kusachius/Fakedata</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Kusachius.Fakedata.Tests\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
